# Copy to .env and fill in. NEVER commit .env or share these values.
# Deployer private key (use a fresh throwaway key for testnet).
PRIVATE_KEY=
# Official Arc values: https://docs.arc.io/arc/references/connect-to-arc
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
# Optional override. Defaults to the official USDC address on Arc networks.
USDC_ADDRESS=
